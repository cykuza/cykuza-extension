{
  "name": "cykuza-extension",
  "description": "Non-custodial Cyberyen wallet browser extension — local ciphertext vault, no telemetry",
  "private": true,
  "version": "0.1.3",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "check:leaks": "node scripts/leak-scan.mjs",
    "check:no-secrets": "node scripts/check-no-secrets.mjs",
    "check:amo": "node scripts/check-amo.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:toolchain": "node scripts/audit-toolchain.mjs",
    "gate": "node scripts/ci-gate.mjs",
    "hash:artifacts": "node scripts/hash-artifacts.mjs",
    "postinstall": "wxt prepare && node scripts/install-git-hooks.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "1.2.0",
    "@scure/bip39": "2.2.0",
    "bip32": "5.0.1",
    "bitcoinjs-lib": "7.0.1",
    "buffer": "^6.0.3",
    "ecpair": "3.0.1",
    "hash-wasm": "4.12.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.8.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.3"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "nanoid": "3.3.18",
    "shell-quote": "^1.10.0",
    "tmp": "^0.2.7"
  }
}
